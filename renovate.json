{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Seoul",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "ignoreTests": true,    
      "addLabels": ["auto-update"],
      "prTitle": "BLD: {{{depName}}} {{{newValue}}} 버전 업데이트"
    },
  ],
  "prConcurrentLimit": 7,
}
