{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Seoul",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "ignoreTests": true,    
      "addLabels": ["auto-update", "enhancement"],
      "commitMessagePrefix": "[ENH]",
      "commitMessageTopic": "{{{depName}}}",
      "commitMessageExtra": "[{{{currentValue}}} → {{{newValue}}}] 마이너 업데이트",
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "reviewers": ["HongDongk"],
      "addLabels": ["major-update", "enhancement"],
      "commitMessagePrefix": "ENH:",
      "commitMessageTopic": "{{{depName}}}",
      "commitMessageExtra": "{{{newValue}}} 메인 업데이트"
    }
  ],
  "prConcurrentLimit": 7,
}
