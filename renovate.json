{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Seoul",
  "reviewers": ["HongDongk"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "ignoreTests": true,    
      "addLabels": ["automerge"]
    }
  ],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "0"
}
