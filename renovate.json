{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Seoul",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "ignoreTests": true,    
      "addLabels": ["auto-update"],
      "commitMessage": "[BLD] {{{depName}}} {{{currentValue}}} -> {{{newValue}}} 버전 업데이트",
      "prTitle": "BLD: {{{depName}}} {{{newValue}}} 버전 업데이트"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "ignoreTests": true,  
      "reviewers": ["HongDongk"],
      "addLabels": ["major-update"],
      "commitMessage": "[BLD] {{{depName}}} {{{currentValue}}} -> {{{newValue}}} 버전 업데이트",
      "prTitle": "BLD: {{{depName}}} {{{newValue}}} 버전 업데이트"
    }
  ],
  "prConcurrentLimit": 7,
  "minimumReleaseAge": "0"
}
