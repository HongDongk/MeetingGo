{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Seoul",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "ignoreTests": true,    
      "addLabels": ["auto-update", "enhancement"],
      "commitMessagePrefix": "[BLD]",
      "commitMessageExtra": "{{currentValue}} -> {{newValue}} 마이너 버전 업데이트",
      "prTitle": "BLD: {{{depName}}} {{{newValue}}} 마이너 버전 업데이트",
    },
  ],
  "prConcurrentLimit": 7,
}
